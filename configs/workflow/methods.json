{
  "schema_version": 1,
  "methods": {
    "dense": {"description": "Uncompressed Qwen2.5-VL"},
    "old_mlp": {
      "algorithm": "feature_anchor_adapter", "checkpoint": "old_mlp",
      "options": {"identity_path": "${identity_path}", "adapter_path": "${method_checkpoint}", "tokens_per_crop": 128}
    },
    "visual_selector": {
      "algorithm": "learned_visual_topk", "checkpoint": "visual_selector",
      "options": {"identity_path": "${identity_path}", "checkpoint_path": "${method_checkpoint}", "seed": 42, "target_count": 128, "width": 256}
    },
    "image_context_selector": {
      "algorithm": "context_visual_topk", "checkpoint": "image_context_selector",
      "options": {"identity_path": "${identity_path}", "checkpoint_path": "${method_checkpoint}", "seed": 42, "target_count": 128, "width": 256, "context_mode": "image"}
    },
    "question_context_selector": {
      "algorithm": "context_visual_topk", "checkpoint": "question_context_selector",
      "options": {"identity_path": "${identity_path}", "checkpoint_path": "${method_checkpoint}", "seed": 42, "target_count": 128, "width": 256, "context_mode": "question"}
    },
    "protected_selector": {
      "algorithm": "protected_visual_topk", "checkpoint": "protected_selector", "conditioning_modalities": ["text"],
      "options": {"identity_path": "${identity_path}", "checkpoint_path": "${method_checkpoint}", "seed": 42, "target_count": 128, "width": 256, "match_width": 128, "visual_only": false,
        "protection": {"maximum_anchor_ratio": 0.5, "minimum_anchor": 20, "novelty_patience": 3, "novelty_threshold": 0.2, "relevance": "learned_word"}}
    },
    "eadp": {"algorithm": "eadp", "options": {"alpha": 0.5, "beta": 2.0, "tokens_per_crop": 128}},
    "prunesid": {"algorithm": "prunesid", "options": {"tokens_per_crop": 128}},
    "mmtok": {"algorithm": "mmtok", "options": {"target_count": 128}},
    "importance_fps": {
      "description": "R1: importance FPS, mean pooling, frozen aggregation MLP",
      "algorithm": "importance_anchor_adapter", "checkpoint": "old_mlp", "scorer": "image_context_selector",
      "options": {"identity_path": "${identity_path}", "adapter_path": "${method_checkpoint}", "tokens_per_crop": 128, "scorer_path": "${scorer_checkpoint}", "importance_gamma": 1.0, "singleton_bypass": false, "spatial_beta": 0.0, "pooling": "mean"}
    },
    "importance_fps_pool": {
      "description": "T2: importance FPS, weighted pooling, frozen aggregation MLP",
      "algorithm": "importance_anchor_adapter", "checkpoint": "old_mlp", "scorer": "image_context_selector",
      "options": {"identity_path": "${identity_path}", "adapter_path": "${method_checkpoint}", "tokens_per_crop": 128, "scorer_path": "${scorer_checkpoint}", "importance_gamma": 1.0, "singleton_bypass": false, "spatial_beta": 0.0, "pooling": "importance"}
    }
  }
}
